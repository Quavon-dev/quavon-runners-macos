# Copy to .env and fill in. The file holds a token: chmod 600 .env
#   cp .env.example .env && chmod 600 .env

# GitHub organisation the runners register with.
GITHUB_ORG=quavon-dev

# Personal access token used ONLY to mint short-lived runner registration
# tokens. It is never written into the runner directory.
#   Classic PAT       -> scope: admin:org
#   Fine-grained PAT  -> organisation permission "Self-hosted runners: Read and write"
# Leave empty to fall back to the gh CLI (`gh auth login`).
GITHUB_PAT=

# Extra labels appended to the auto-detected ones (macOS, x64|arm64, macos-<major>).
# Example: sonoma,xcode-15,quavon
RUNNER_LABELS=

# Runner group in the org (needs GitHub Team/Enterprise for custom groups).
RUNNER_GROUP=Default

# Runner name prefix. Defaults to the short hostname; with RUNNER_COUNT > 1 the
# installer appends -1, -2, ...
#RUNNER_NAME_PREFIX=

# How many runners to install on this host. Keep it at or below the core count.
RUNNER_COUNT=1

# Where runner installations live.
RUNNER_BASE_DIR=$HOME/actions-runners

# Runner version: "latest" or a pinned version such as 2.337.0
RUNNER_VERSION=latest

# Work directory name inside each runner installation.
RUNNER_WORK_DIR=_work

# true  -> each job gets a freshly registered runner that is discarded afterwards
#          (cleaner isolation, slightly slower job start)
# false -> one long-lived runner process
RUNNER_EPHEMERAL=false
